{
  "name": "harvest-chrome-extension",
  "version": "1.0.0",
  "description": "Harvest Chrome extension",
  "license": "AGPL-3.0-only",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "package:extension": "node scripts/package-extension.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node --test tests/*.browser.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:version": "node scripts/check-version.mjs",
    "version:next": "node scripts/version-next.mjs",
    "version:check-staged": "node scripts/check-version-staged.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:build": "node scripts/check-build.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "check:release": "node scripts/check-release.mjs",
    "verify": "pnpm check:runtime && pnpm build && pnpm typecheck && pnpm check:architecture && pnpm test && pnpm check:manifest && pnpm check:build && pnpm check:version",
    "verify:full": "pnpm verify && pnpm test:ui",
    "verify:ci": "pnpm verify:full && pnpm check:generated",
    "verify:release": "pnpm verify:full && pnpm check:release",
    "setup:hooks": "node scripts/setup-hooks.mjs",
    "check:architecture": "node scripts/check-architecture.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@jsquash/jxl": "1.3.0",
    "mediabunny": "1.61.0"
  },
  "type": "module"
}
