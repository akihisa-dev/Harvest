{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.3.0",
  "default_locale": "ja",
  "permissions": [
    "tabs",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Harvestを開く"
  },
  "side_panel": {
    "default_path": "app/index.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
